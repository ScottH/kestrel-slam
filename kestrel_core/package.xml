<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kestrel_core</name>
  <version>0.1.0</version>
  <description>
    Kestrel SLAM core library: ROS-independent stereo-inertial SLAM with loop closure and
    lifelong mapping for changing environments.
  </description>
  <maintainer email="sh@co.bot">Kestrel SLAM maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>eigen</depend>
  <depend>libopencv-dev</depend>
  <depend>libceres-dev</depend>
  <depend>yaml-cpp</depend>

  <test_depend>gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
